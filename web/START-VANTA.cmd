@echo off
setlocal
set "VANTA_APP_DIR=%~dp0"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { $vantaRoot=$env:VANTA_APP_DIR; Set-Location -LiteralPath $vantaRoot; if(-not [Environment]::Is64BitOperatingSystem){ throw 'VANTA needs 64-bit Windows.' }; $vantaRuntime=Join-Path $vantaRoot '.vanta-runtime'; $vantaCache=Join-Path $vantaRuntime 'node-downloads'; $vantaFolder=Join-Path $vantaRuntime 'node-v24.22.0-win-x64'; $vantaNode=Join-Path $vantaFolder 'node.exe'; New-Item -ItemType Directory -Force -Path $vantaRuntime,$vantaCache | Out-Null; $nodeOk=$false; if(Test-Path -LiteralPath $vantaNode){ try { $version=& $vantaNode --version 2>$null; if($LASTEXITCODE -eq 0 -and $version){ $nodeOk=$true } } catch { $nodeOk=$false } }; if(-not $nodeOk){ Write-Host 'Repairing VANTA portable Node runtime...'; if(Test-Path -LiteralPath $vantaFolder){ Remove-Item -LiteralPath $vantaFolder -Recurse -Force }; $vantaArchive=Join-Path $vantaCache 'node-v24.22.0-win-x64.zip'; $vantaExpected='f9683a19877e12a9b167305c8db71040d812876359de21f0d2e97c3f321f80c3'; $valid=(Test-Path -LiteralPath $vantaArchive) -and ((Get-FileHash -Algorithm SHA256 -LiteralPath $vantaArchive).Hash.ToLowerInvariant() -eq $vantaExpected); if(-not $valid){ $partial=$vantaArchive+'.partial'; Remove-Item -LiteralPath $partial -Force -ErrorAction SilentlyContinue; Write-Host 'Downloading verified portable Node.js 24.22.0...'; Invoke-WebRequest -UseBasicParsing -Uri 'https://nodejs.org/dist/v24.22.0/node-v24.22.0-win-x64.zip' -OutFile $partial; if((Get-FileHash -Algorithm SHA256 -LiteralPath $partial).Hash.ToLowerInvariant() -ne $vantaExpected){ Remove-Item -LiteralPath $partial -Force; throw 'Node.js checksum verification failed.' }; Move-Item -LiteralPath $partial -Destination $vantaArchive -Force }; Expand-Archive -LiteralPath $vantaArchive -DestinationPath $vantaRuntime -Force; if(-not (Test-Path -LiteralPath $vantaNode)){ throw 'Portable Node extraction did not create node.exe.' }; try { Unblock-File -LiteralPath $vantaNode -ErrorAction SilentlyContinue } catch {}; try { & icacls.exe $vantaNode /grant ($env:USERNAME+':RX') /C | Out-Null } catch {}; try { $version=& $vantaNode --version; if($LASTEXITCODE -ne 0 -or -not $version){ throw 'Portable Node could not run.' } } catch { throw ('Portable VANTA Node is still blocked by Windows: '+$_.Exception.Message) } }; $vantaNodeDir=Split-Path -Parent $vantaNode; $env:Path=$vantaNodeDir+';'+$env:Path; & $vantaNode --use-env-proxy --use-system-ca (Join-Path $vantaRoot 'scripts\start-local.mjs'); exit $LASTEXITCODE } catch { Write-Host ('VANTA could not start: '+$_.Exception.Message) -ForegroundColor Red; exit 1 }"
set "VANTA_STATUS=%ERRORLEVEL%"
if not "%VANTA_STATUS%"=="0" (
  echo.
  echo Startup stopped. Read the message above.
  pause
)
exit /b %VANTA_STATUS%
